# Copy to .env for local development (never commit your real .env).

# Postgres connection string.
# Local example:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/blues_jam
# On Render: use the database's "Internal Database URL" (Connections tab).
DATABASE_URL=

# Disable SSL for local Postgres (Render's managed Postgres needs SSL, which is
# enabled automatically). Set to "disable" locally if your Postgres has no SSL.
# PGSSLMODE=disable

# Admin PIN used to unlock the admin panel and admin-only actions.
ADMIN_PIN=Admin123

# Optional: set by Render automatically. Enables the keep-alive self-ping.
# RENDER_EXTERNAL_URL=
